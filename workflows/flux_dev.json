{
  "10": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "flux1-dev.safetensors"}},
  "11": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["10", 1]}},
  "12": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{negative_prompt}}", "clip": ["10", 1]}},
  "13": {"class_type": "EmptyLatentImage", "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}},
  "20": {"class_type": "KSampler", "inputs": {
    "model": ["10", 0], "positive": ["11", 0], "negative": ["12", 0], "latent_image": ["13", 0],
    "seed": "{{seed}}", "steps": "{{steps}}", "cfg": 3.5, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0
  }},
  "30": {"class_type": "VAEDecode", "inputs": {"samples": ["20", 0], "vae": ["10", 2]}},
  "40": {"class_type": "SaveImage", "inputs": {"images": ["30", 0], "filename_prefix": "hflocal"}}
}
